<div class="article-list">
  {% for article in articles|filter(article => article.has('url')) %}


    <article class="article">

      <div class="row">
        {% if article.model|hasImage %}
          <div class="col-sm-4 pull-right" id="cover">
            {% include "AppBundle:Article:_cover.html.twig" with {
              article: article.model,
              width: 200
            } %}
          </div>
        {% endif %}
        <div class="col-md-8">
          <h1>
            <a href="{{ path('article_show', { slug: article.url }) }}">
              {{ article.title }}
            </a>
          </h1>

          <div>
            <p>de {{ article.authors }}</p>

            <p>
              {% if article.isPhysical() %}
                Papier
              {% else %}
                Numérique
              {% endif %}
            </p>

            {% if article.has('price') %}
              <p>{{ article.price|currency(true)|raw }}</p>
              <p>{% include "AppBundle:Article:_cartButtonOrSoldOut.html.twig" with { article: article, label: 'Ajouter au panier' } %}</p>
            {% else %}
              <p>Gratuit</p>
              <p>{% include "AppBundle:Article:_cartButtonOrSoldOut.html.twig" with { article: article, label: 'Télécharger gratuitement' } %}</p>
            {% endif %}
          </div>


        </div>
      </div>

    </article>
  {% endfor %}
</div>

{% include 'AppBundle:Article:_list_pagination.html.twig' %}
